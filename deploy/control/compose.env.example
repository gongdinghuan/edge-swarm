# Use an absolute path outside the repository and build context.
SWARM_SECRETS_DIR=/etc/edge-swarm/secrets
SWARM_DOMAIN=swarm.example.org
# Replace with reviewed immutable digests. This volume layout expects PostgreSQL 17.
POSTGRES_IMAGE=postgres:17@sha256:REPLACE_ME
CADDY_IMAGE=caddy:2@sha256:REPLACE_ME
