# Literal KEY=value. Keep the real file at mode 0600.
# Run swarm.sh init to generate SWARM_ADMIN_TOKEN and SWARM_API_KEYS.
SWARM_PORT=8080
SWARM_ADMIN_TOKEN=REPLACE_ME
SWARM_API_KEYS={"REPLACE_ME":"default"}
# Set for public deployments. Use URL-encoded credentials and verify TLS for remote databases.
# SWARM_DATABASE_URL=postgres://swarm:REPLACE_ME@db.example.org:5432/swarm?sslmode=verify-full
# SWARM_MODEL_ACCESS={"default":["my-model"]}
# Optional foreground-only SQLite data directory. systemd uses /var/lib/edge-swarm.
# SWARM_STATE_DIR=/srv/edge-swarm-state
